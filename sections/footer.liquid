{{ 'footer-editorial.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer section-{{ section.id }}-padding">
  <div class="page-width footer__layout">
    <div class="footer__logo-column"></div>

    <div class="footer__menu-column">
      <div class="footer__menu-grid">
        <div class="footer__menu-group">
          <h2 class="footer__menu-heading">{{ section.settings.shop_heading | escape }}</h2>
          {%- if section.settings.shop_menu != blank -%}
            <ul class="footer__menu-list list-unstyled">
              {%- for link in section.settings.shop_menu.links -%}
                <li>
                  <a class="footer__menu-link" href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="footer__menu-group">
          <h2 class="footer__menu-heading">{{ section.settings.about_heading | escape }}</h2>
          {%- if section.settings.about_menu != blank -%}
            <ul class="footer__menu-list list-unstyled">
              {%- for link in section.settings.about_menu.links -%}
                <li>
                  <a class="footer__menu-link" href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="footer__menu-group">
          <h2 class="footer__menu-heading">{{ section.settings.support_heading | escape }}</h2>
          {%- if section.settings.support_menu != blank -%}
            <ul class="footer__menu-list list-unstyled">
              {%- for link in section.settings.support_menu.links -%}
                <li>
                  <a class="footer__menu-link" href="{{ link.url }}">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="footer__newsletter-column"></div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop column heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "About column heading",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "About menu"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support column heading",
      "default": "Support"
    },
    {
      "type": "link_list",
      "id": "support_menu",
      "label": "Support menu"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ]
}
{% endschema %}
