{{ 'footer-editorial.css' | asset_url | stylesheet_tag }}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign footer_background = section.settings.footer_background | default: '#59766B'
  assign brand_tagline = section.settings.brand_tagline | default: 'Crafted beauty in every piece,<br>connection in every game'
  assign shop_heading = section.settings.shop_heading | default: 'Shop'
  assign about_heading = section.settings.about_heading | default: 'About'
  assign customers_heading = section.settings.customers_heading | default: 'Customers'
-%}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    background-color: {{ footer_background }};
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="footer__content-top page-width footer__custom-grid">
    <div class="footer__brand-column">
      {%- if settings.brand_image != blank -%}
        {%- assign brand_image_height = settings.brand_image_width | divided_by: settings.brand_image.aspect_ratio -%}
        <div class="footer-block__image-wrapper" style="max-width: min(100%, {{ settings.brand_image_width }}px);">
          {{
            settings.brand_image
            | image_url: width: 1100
            | image_tag:
              loading: 'lazy',
              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
              height: brand_image_height,
              width: settings.brand_image_width
          }}
        </div>
      {%- endif -%}

      <div class="footer__brand-tagline rte">{{ brand_tagline }}</div>
    </div>

    <div class="footer__menu-column">
      <h2 class="footer-block__heading inline-richtext">{{ shop_heading }}</h2>
      <ul class="footer-block__details-content list-unstyled">
        {%- if section.settings.shop_menu != blank -%}
          {%- for link in section.settings.shop_menu.links -%}
            <li><a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}" class="link link--text list-menu__item list-menu__item--link">Collections</a></li>
        {%- endif -%}
      </ul>
    </div>

    <div class="footer__menu-column">
      <h2 class="footer-block__heading inline-richtext">{{ about_heading }}</h2>
      <ul class="footer-block__details-content list-unstyled">
        {%- if section.settings.about_menu != blank -%}
          {%- for link in section.settings.about_menu.links -%}
            <li><a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        {%- else -%}
          {%- if pages['our-story'] != blank -%}<li><a href="{{ pages['our-story'].url }}" class="link link--text list-menu__item list-menu__item--link">Our Story</a></li>{%- endif -%}
          {%- if pages['our-founder'] != blank -%}<li><a href="{{ pages['our-founder'].url }}" class="link link--text list-menu__item list-menu__item--link">Our Founder</a></li>{%- endif -%}
          {%- if pages['events'] != blank -%}<li><a href="{{ pages['events'].url }}" class="link link--text list-menu__item list-menu__item--link">Events</a></li>{%- endif -%}
          {%- if pages['reviews'] != blank -%}<li><a href="{{ pages['reviews'].url }}" class="link link--text list-menu__item list-menu__item--link">Reviews</a></li>{%- endif -%}
          {%- if pages['press'] != blank -%}<li><a href="{{ pages['press'].url }}" class="link link--text list-menu__item list-menu__item--link">Press</a></li>{%- endif -%}
        {%- endif -%}
      </ul>
    </div>

    <div class="footer__menu-column">
      <h2 class="footer-block__heading inline-richtext">{{ customers_heading }}</h2>
      <ul class="footer-block__details-content list-unstyled">
        {%- if section.settings.customers_menu != blank -%}
          {%- for link in section.settings.customers_menu.links -%}
            <li><a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.account_url }}" class="link link--text list-menu__item list-menu__item--link">My Account</a></li>
          {%- if pages['faq'] != blank -%}<li><a href="{{ pages['faq'].url }}" class="link link--text list-menu__item list-menu__item--link">FAQ</a></li>{%- endif -%}
          {%- if pages['tile-care'] != blank -%}<li><a href="{{ pages['tile-care'].url }}" class="link link--text list-menu__item list-menu__item--link">Tile Care</a></li>{%- endif -%}
          {%- if pages['contact'] != blank -%}<li><a href="{{ pages['contact'].url }}" class="link link--text list-menu__item list-menu__item--link">Contact</a></li>{%- endif -%}
          {%- if pages['returns'] != blank -%}<li><a href="{{ pages['returns'].url }}" class="link link--text list-menu__item list-menu__item--link">Returns</a></li>{%- endif -%}
          {%- if pages['shipping'] != blank -%}<li><a href="{{ pages['shipping'].url }}" class="link link--text list-menu__item list-menu__item--link">Shipping</a></li>{%- endif -%}
          {%- if pages['privacy-policy'] != blank -%}<li><a href="{{ pages['privacy-policy'].url }}" class="link link--text list-menu__item list-menu__item--link">Privacy Policy</a></li>{%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_policies_in_customers and section.settings.customers_menu == blank -%}
          {%- if shop.refund_policy != blank -%}
            <li><a href="{{ shop.refund_policy.url }}" class="link link--text list-menu__item list-menu__item--link">{{ shop.refund_policy.title | escape }}</a></li>
          {%- endif -%}
          {%- if shop.shipping_policy != blank -%}
            <li><a href="{{ shop.shipping_policy.url }}" class="link link--text list-menu__item list-menu__item--link">{{ shop.shipping_policy.title | escape }}</a></li>
          {%- endif -%}
          {%- if shop.privacy_policy != blank -%}
            <li><a href="{{ shop.privacy_policy.url }}" class="link link--text list-menu__item list-menu__item--link">{{ shop.privacy_policy.title | escape }}</a></li>
          {%- endif -%}
        {%- endif -%}
      </ul>
    </div>

    <div class="footer-block--newsletter">
      {%- if section.settings.newsletter_enable -%}
        <div class="footer-block__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-form__field-wrapper">
              <div class="field">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="field__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="ContactFooter-error"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="ContactFooter-success"
                  {% endif %}
                  placeholder="{{ 'newsletter.label' | t }}"
                  required
                >
                <label class="field__label" for="NewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
                <button
                  type="submit"
                  class="newsletter-form__button field__button"
                  name="commit"
                  id="Subscribe"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                </button>
              </div>
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="ContactFooter-error">
                  <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}
            </div>
            {%- if form.posted_successfully? -%}
              <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="ContactFooter-success" tabindex="-1" autofocus>
                <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
                {{- 'newsletter.success' | t }}
              </h3>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_instagram and settings.social_instagram_link != blank -%}
        <ul class="footer__list-social list-unstyled list-social" role="list">
          <li class="list-social__item">
            <a href="{{ settings.social_instagram_link }}" class="link list-social__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.instagram' | t }}">
              <span class="svg-wrapper">{{- 'icon-instagram.svg' | inline_asset_content -}}</span>
            </a>
          </li>
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="footer__content-bottom footer__content-bottom--simple">
    <div class="footer__content-bottom-wrapper page-width footer__content-bottom-wrapper--center">
      <div class="footer__copyright caption">
        <small class="copyright__content">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</small>
        <small class="copyright__content">{{ powered_by_link }}</small>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "footer_background",
      "label": "Footer background",
      "default": "#59766B"
    },
    {
      "type": "inline_richtext",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "Crafted beauty in every piece,<br>connection in every game"
    },
    {
      "type": "header",
      "content": "Footer columns"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "About heading",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "About menu"
    },
    {
      "type": "text",
      "id": "customers_heading",
      "label": "Customers heading",
      "default": "Customers"
    },
    {
      "type": "link_list",
      "id": "customers_menu",
      "label": "Customers menu"
    },
    {
      "type": "checkbox",
      "id": "show_policies_in_customers",
      "label": "Add Shopify policy links to Customers",
      "default": true
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Show Instagram icon",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.padding_top.label",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.padding_bottom.label",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name"
    }
  ]
}
{% endschema %}
