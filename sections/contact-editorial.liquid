{% style %}
  .contact-editorial {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding: clamp(26px, 6vw, 96px) 0;
  }

  .contact-editorial__wrap {
    width: min(820px, calc(100% - 48px));
    margin: 0 auto;
  }

.contact-editorial__kicker {
  text-align: center;
  font-size: 0.9rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin: 0 0 12px;
  opacity: 0.85;
}

.contact-editorial__title {
  font-size: clamp(32px, 2.6vw, 46px);
  letter-spacing: 0.02em;
  margin: 0 0 26px;
  line-height: 1.05;
  text-align: center;
}

.contact-editorial__intro {
  max-width: 520px;   /* must match form */
  margin: 0 auto 22px;
  font-size: 1.15rem;
  line-height: 1.6;
  opacity: 0.95;
    text-align: center;
}


  /* Form column */
.contact-editorial__form {
  max-width: 520px;
  margin: 0 auto;
}

/* One field = one visual block */
.contact-editorial__field {
  margin-bottom: 32px;
}

/* Label sits closer to the line */
.contact-editorial__field label {
  display: block;
  margin-bottom: 6px;
  font-size: 1.35rem;
  letter-spacing: 0.01em;
  opacity: 0.9;
}


.contact-editorial__field input,
.contact-editorial__field textarea {
  width: 100%;
  padding: 12px 0 10px;
  font-size: 1.15rem;
  background: transparent !important;
  border: 0 !important;
  border-bottom: 1.5px solid rgba(var(--color-foreground), 0.35) !important;
  box-shadow: none !important;
  outline: none !important;
  border-radius: 0 !important;
  appearance: none;
}

.contact-editorial__field input:-webkit-autofill,
.contact-editorial__field textarea:-webkit-autofill {
  -webkit-box-shadow: 0 0 0 1000px transparent inset !important;
  -webkit-text-fill-color: rgb(var(--color-foreground)) !important;
  transition: background-color 9999s ease-out 0s;
}


  .contact-editorial__field textarea {
    min-height: 180px;
    padding-top: 8px;
    resize: vertical;
  }

.contact-editorial__field input:focus,
.contact-editorial__field textarea:focus {
  outline: none;
  border-bottom-color: rgba(var(--color-foreground), 0.65);
}


  .contact-editorial__actions {
    margin-top: 34px;
  }

  .contact-editorial__actions button {
    width: 100%;
    padding: 14px 18px;
    border-radius: 6px;
  }

  .contact-editorial__note {
    margin-top: 16px;
    font-size: 0.9rem;
    opacity: 0.8;
    text-align: left;
  }

.contact-editorial__direct-email {
  margin-top: 22px;
  font-size: 1.35rem;        /* SAME as labels */
  letter-spacing: 0.02em;    /* SAME as labels */
  opacity: 0.95;
  text-align: center;
}

.contact-editorial__direct-email a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 3px;
}



  .contact-editorial__success,
  .contact-editorial__errors {
    margin: 18px 0 0;
    padding: 14px 16px;
    border: 1px solid rgba(var(--color-foreground), 0.25);
    border-radius: 8px;
  }
{% endstyle %}

<section class="contact-editorial color-{{ section.settings.color_scheme }}">
  <div class="contact-editorial__wrap">
    {% if section.settings.kicker != blank %}
      <p class="contact-editorial__kicker">{{ section.settings.kicker }}</p>
    {% endif %}

    <h1 class="contact-editorial__title">
      {{ section.settings.heading | escape }}
    </h1>

    {% if section.settings.intro_richtext != blank %}
      <div class="contact-editorial__intro rte">
        {{ section.settings.intro_richtext }}
      </div>
    {% endif %}

    <div class="contact-editorial__form">
      {% form 'contact', id: 'ContactForm' %}
        {% if form.posted_successfully? %}
          <div class="contact-editorial__success" role="status">
            {{ section.settings.success_message | escape }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="contact-editorial__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="contact-editorial__field">
          <label for="ContactForm-name">Full Name*</label>
          <input
            id="ContactForm-name"
            type="text"
            name="contact[name]"
            autocomplete="name"
            required
            value="{{ form.name | escape }}"
          >
        </div>

        <div class="contact-editorial__field">
          <label for="ContactForm-email">Email*</label>
          <input
            id="ContactForm-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            value="{{ form.email | escape }}"
          >
        </div>

        <div class="contact-editorial__field">
          <label for="ContactForm-phone">Phone Number</label>
          <input
            id="ContactForm-phone"
            type="tel"
            name="contact[phone]"
            autocomplete="tel"
            value="{{ form.phone | escape }}"
          >
        </div>

        <div class="contact-editorial__field">
          <label for="ContactForm-body">Message*</label>
          <textarea
            id="ContactForm-body"
            name="contact[body]"
            required
          >{{ form.body | escape }}</textarea>
        </div>

        <div class="contact-editorial__actions">
          <button type="submit" class="button">
            {{ section.settings.button_label | escape }}
          </button>
          {% if section.settings.required_note != blank %}
            <div class="contact-editorial__note">{{ section.settings.required_note }}</div>
          {% endif %}

            <div class="contact-editorial__direct-email">
            Or email us at <a href="mailto:yalla@yallamahjong.com">yalla@yallamahjong.com</a>
            </div>
        </div>



      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact (Editorial)",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "DON'T JUST PLAY. COLLECT."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CONTACT US"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h0",
      "options": [
        { "value": "h0", "label": "H0 (largest)" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ]
    },
    {
      "type": "richtext",
      "id": "intro_richtext",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SEND"
    },
    {
      "type": "text",
      "id": "required_note",
      "label": "Required note",
      "default": "Fields marked with an asterisk (*) are required.  "
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks — we’ve received your message."
    }
  ],
  "presets": [
    { "name": "Contact (Editorial)" }
  ]
}
{% endschema %}
